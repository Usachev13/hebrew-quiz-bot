# Скопируй этот файл в .env и впиши реальные значения.
# .env никогда не попадёт в git (см. .gitignore) — так токены не утекут на GitHub.
TELEGRAM_TOKEN=твой_токен_от_BotFather

# Нужен только для deploy.sh (reload веб-приложения через API без веб-интерфейса).
# Взять на pythonanywhere.com: Account -> вкладка API Token.
# Актуально только пока бот на PythonAnywhere.
PA_API_TOKEN=твой_api_токен_pythonanywhere

# Нужен только при деплое на VPS — домен, по которому Telegram стучится
# в вебхук, например ivrit-trainer.duckdns.org (см. deploy/README).
BOT_DOMAIN=твой-домен.duckdns.org

# Кому доступна команда /admin — сводка по всей аудитории.
# Свой chat_id можно узнать, набрав /admin при незаполненной переменной:
# бот ответит именно им и ничего больше не покажет.
ADMIN_CHAT_ID=

# --- Озвучка (Azure Speech) ---
# Нужна ТОЛЬКО для разовой генерации (tools/generate_audio.py).
# Сам бот при работе никуда не ходит — он читает готовые файлы.

# Ключ и регион со страницы «Ключи и конечная точка» ресурса «Речь».
# Регион обязан совпадать с тем, где создан ресурс: ключи привязаны
# к региону, иначе будет ошибка авторизации.
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=uaenorth

# Голос: he-IL-HilaNeural (женский) или he-IL-AvriNeural (мужской).
# TTS_VOICE=he-IL-HilaNeural

# Темпы. Каждая карточка озвучивается в обоих, ученик переключает
# их в боте командой /speed.
# TTS_RATE=0%
# TTS_RATE_SLOW=-25%

# Явные паузы в режиме ipa. По умолчанию выключены: синтезатор
# расставляет их сам по знакам препинания. Включать, только если нужно
# разделять слова сильнее — например, для совсем начинающих.
# TTS_WORD_BREAK=150ms
# TTS_SENTENCE_BREAK=500ms

# --- Диагностика ---
# Шаг, который занял больше этого времени (в секундах), попадёт в журнал
# строкой «[медленно] …». Помогает понять, что именно тормозит, если бот
# подвисает: journalctl -u hebrew-quiz-bot | grep медленно
# BOT_SLOW_STEP=1.0
