# Скопируй этот файл в .env и впиши реальные значения.
# .env никогда не попадёт в git (см. .gitignore) — так токены не утекут на GitHub.
TELEGRAM_TOKEN=твой_токен_от_BotFather

# Нужен только для deploy.sh (reload веб-приложения через API без веб-интерфейса).
# Взять на pythonanywhere.com: Account -> вкладка API Token.
# Актуально только пока бот на PythonAnywhere.
PA_API_TOKEN=твой_api_токен_pythonanywhere

# Нужен только при деплое на VPS — домен, по которому Telegram стучится
# в вебхук, например ivrit-trainer.duckdns.org (см. deploy/README).
BOT_DOMAIN=твой-домен.duckdns.org

# Кому доступна команда /admin — сводка по всей аудитории.
# Свой chat_id можно узнать, набрав /admin при незаполненной переменной:
# бот ответит именно им и ничего больше не покажет.
ADMIN_CHAT_ID=

# --- Озвучка (Azure Speech) ---
# Нужна ТОЛЬКО для разовой генерации (tools/generate_audio.py).
# Сам бот при работе никуда не ходит — он читает готовые файлы.

# Ключ и регион со страницы «Ключи и конечная точка» ресурса «Речь».
# Регион обязан совпадать с тем, где создан ресурс: ключи привязаны
# к региону, иначе будет ошибка авторизации.
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=uaenorth

# Голос: he-IL-HilaNeural (женский) или he-IL-AvriNeural (мужской).
# TTS_VOICE=he-IL-HilaNeural

# Темпы. Каждая карточка озвучивается в обоих, ученик переключает
# их в боте командой /speed.
# TTS_RATE=0%
# TTS_RATE_SLOW=-25%

# Явные паузы в режиме ipa. По умолчанию выключены: синтезатор
# расставляет их сам по знакам препинания. Включать, только если нужно
# разделять слова сильнее — например, для совсем начинающих.
# TTS_WORD_BREAK=150ms
# TTS_SENTENCE_BREAK=500ms

# --- Диагностика ---
# Шаг, который занял больше этого времени (в секундах), попадёт в журнал
# строкой «[медленно] …». Помогает понять, что именно тормозит, если бот
# подвисает: journalctl -u hebrew-quiz-bot | grep медленно
# BOT_SLOW_STEP=1.0

# --- Разговор (языковая модель) ---
# Единственная часть бота, которая тратит деньги на каждом сообщении, и
# единственная, где иврит никем не выверен. Без ключа разговор просто не
# предлагается — как озвучка без ключа Azure.
#
# Нужен ОДИН ключ из трёх. Порядок выбора, если стоят несколько:
# Anthropic, OpenAI, Google. Порядок произволен и значит лишь «какой-то
# один» — чтобы взять именно нужный, уберите лишние ключи.
#
# Google бесплатен и его предела (тысячи запросов в день) хватает с
# запасом: у нас сорок реплик на человека в сутки. Ключ берётся в Google
# AI Studio, карта не нужна.
# Цена у бесплатного уровня всё же есть, просто не деньгами: разговоры
# уходят на улучшение чужих продуктов. Пока учеником пользуетесь вы —
# неважно. Появятся платящие ученики — решать это надо ДО них.
GOOGLE_API_KEY=…
# ANTHROPIC_API_KEY=…
# OPENAI_API_KEY=…

# Если Google не выдал ключ (в рабочем аккаунте создание проектов часто
# запрещено администратором), берите любого, кто говорит на протоколе
# OpenAI, — их много, и они бесплатны. Сменой адреса подключается любой,
# нового кода не нужно:
#
#   Groq        console.groq.com          ключ gsk_…
#               OPENAI_BASE_URL=https://api.groq.com/openai/v1
#               DIALOG_MODEL_OPENAI=llama-3.3-70b-versatile
#
#   OpenRouter  openrouter.ai/keys        ключ sk-or-…
#               OPENAI_BASE_URL=https://openrouter.ai/api/v1
#               DIALOG_MODEL_OPENAI=…:free  (список на сайте)
#
# Оговорка про иврит: открытые модели знают его заметно хуже Gemini, а
# для нас это не мелочь — собеседник ставит огласовки. Ошибётся в них —
# сработает наша проверка, огласовки снимутся, и человек останется без
# транскрипции. Доля таких ответов видна в /admin: если она велика,
# модель для иврита не годится, какой бы бесплатной ни была.
# OPENAI_BASE_URL=…

# Модель. По умолчанию берутся дешёвые: им хватает того, что от них
# требуется — две короткие фразы бытового иврита.
# DIALOG_MODEL_GOOGLE=gemini-2.5-flash
# DIALOG_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# DIALOG_MODEL_OPENAI=gpt-4o-mini

# Сколько реплик в сутки на человека. Не чтобы экономить на ученике, а
# чтобы одна забытая вкладка не съела месячный бюджет.
# DIALOG_DAILY_LIMIT=40
