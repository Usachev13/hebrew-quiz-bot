# Скопируй этот файл в .env и впиши реальные значения.
# .env никогда не попадёт в git (см. .gitignore) — так токены не утекут на GitHub.
TELEGRAM_TOKEN=твой_токен_от_BotFather

# Нужен только для deploy.sh (reload веб-приложения через API без веб-интерфейса).
# Взять на pythonanywhere.com: Account -> вкладка API Token.
# Актуально только пока бот на PythonAnywhere.
PA_API_TOKEN=твой_api_токен_pythonanywhere

# Нужен только при деплое на VPS — домен, по которому Telegram стучится
# в вебхук, например ivrit-trainer.duckdns.org (см. deploy/README).
BOT_DOMAIN=твой-домен.duckdns.org
